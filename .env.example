# ==============================================================================
# VoiceFlow Environment Variables Template (.env.example)
# ==============================================================================
# All credentials remain strictly server-side. Never commit .env to version control.
#
# NOTE: VoiceFlow runs STT, LLM, and TTS natively through LiveKit Cloud Inference:
# - STT: deepgram/nova-3
# - LLM: google/gemma-4-31b-it
# - TTS: rime/coda (voice: luna, language: en)
#
# Because inference routing and provider authentication are managed by LiveKit Cloud,
# individual third-party API keys (such as RIME_API_KEY or DEEPGRAM_API_KEY) are NOT
# required on the agent worker or frontend.
# ==============================================================================

# LiveKit Cloud Project Credentials (Required for Agent & Vercel /api/token)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LiveKit Inference Model Overrides (Optional - defaults shown)
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=rime/coda
LIVEKIT_TTS_VOICE=luna

# Optional Local Token Server (Used only for local backend development)
TOKEN_SERVER_PORT=3001


